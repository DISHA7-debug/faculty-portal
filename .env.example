# Copy to .env and fill in. NEVER commit .env.

# ---- Core ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Public hostname / TLS (docs/CUTOVER.md) ----
# No domain is registered yet. These defaults let the full production stack run
# locally over HTTPS using Caddy's internal CA. Nothing else in the repo hardcodes
# a hostname — CI fails the build if anything does (npm run check:hostnames).
#
# SITE_ADDRESS  what Caddy answers on. Cutover: faculty.<college domain>
# CADDY_TLS     argument to Caddy's `tls` directive.
#               `internal` = self-signed local CA, works with no DNS.
#               Cutover: an admin email address, which switches on Let's Encrypt.
SITE_ADDRESS=localhost
CADDY_TLS=internal

# ---- Database ----
# Dev (docker compose):
DATABASE_URL="postgresql://faculty:devpassword@localhost:5432/faculty_portal?schema=public&connection_limit=15"
# Prod (inside the compose network): postgresql://USER:PASS@postgres:5432/faculty_portal?connection_limit=15
POSTGRES_USER=faculty
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=faculty_portal

# ---- Redis (rate limiting) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
SESSION_MAX_AGE_DAYS=7

# ---- Signup policy ----
# Comma-separated. Only these email domains may register.
# Dev default is a reserved .invalid host (RFC 2606) so seeded fixture accounts can
# never receive real mail. Cutover: the real faculty email domain.
# prisma/seed.ts derives its fixture addresses from this, so the two stay in sync.
ALLOWED_EMAIL_DOMAINS="faculty.example.invalid"
# strict = email must also exist in the AllowedEmail table (admin CSV import)
SIGNUP_MODE="domain"          # "domain" | "strict"
REQUIRE_ADMIN_APPROVAL=true   # never set false in production

# ---- Email ----
# DEV (default): Mailpit from docker-compose.yml. No credentials, nothing leaves the
# machine. Read whatever the app "sent" at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
# PROD: Amazon SES (Mumbai) or college SMTP — same code path, these values change.
#   SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
#   SMTP_PORT=587
#   SMTP_USER="<SES SMTP username>"
#   SMTP_PASSWORD="<SES SMTP password>"
MAIL_FROM="Faculty Portal <noreply@example.invalid>"

# ---- Object storage (S3-compatible) ----
# DEV (default): MinIO from docker-compose.yml. Console at http://localhost:9001
# (minioadmin / minioadmin). Nothing leaves the machine.
R2_ACCOUNT_ID="dev"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="faculty-portal-media"
R2_ENDPOINT="http://localhost:9000"
R2_PUBLIC_URL="http://localhost:9000/faculty-portal-media"
# Path-style addressing is required by MinIO; R2 uses it too. Kept explicit so the
# difference is visible rather than surprising at cutover.
S3_FORCE_PATH_STYLE=true
# PROD (Cloudflare R2):
#   R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   R2_PUBLIC_URL="https://cdn.<college domain>"   (R2 custom domain)

# ---- Backups (server-side only, not read by the app) ----
R2_BACKUP_BUCKET="faculty-portal-backups"
BACKUP_PASSPHRASE=""

# ---- Limits ----
MAX_IMAGE_MB=5
MAX_PDF_MB=10
MAX_FILES_PER_USER=60
