{
  "name": "faculty-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "audit": "node scripts/audit.mjs",
    "check:hostnames": "node scripts/check-hostnames.mjs",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --import tsx --test tests/auth/*.test.ts tests/validation/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --import tsx --test tests/integration/*.test.ts",
    "check:ownership": "node scripts/check-ownership.mjs",
    "break-glass": "node --env-file-if-exists=.env --import tsx scripts/break-glass.ts",
    "verify:profile": "node --env-file-if-exists=.env scripts/verify-public-profile.mjs",
    "verify:preview": "node --env-file-if-exists=.env scripts/verify-preview.mjs",
    "seed:stress": "node --env-file-if-exists=.env scripts/seed-stress-profiles.mjs",
    "screenshots": "node --env-file-if-exists=.env scripts/capture-screenshots.mjs",
    "verify:directory": "node --env-file-if-exists=.env scripts/verify-directory.mjs",
    "set-user-email": "node --env-file-if-exists=.env --import tsx scripts/set-user-email.ts",
    "verify:search-index": "node --env-file-if-exists=.env --import tsx scripts/verify-search-index.mjs",
    "verify:admin": "node --env-file-if-exists=.env scripts/verify-admin.mjs",
    "verify:admin-actions": "node --env-file-if-exists=.env --env-file-if-exists=.env.test scripts/verify-admin-actions.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@prisma/client": "^6.19.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^22.0.2",
    "framer-motion": "^13.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.499.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "prisma": "^6.19.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.16.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
